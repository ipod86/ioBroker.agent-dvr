{
  "$schema": "https://raw.githubusercontent.com/ioBroker/web-components/main/schemas/manifest.json",
  "manifestVersion": 1,
  "tag": "iob-agent-dvr-live",
  "name": {
    "en": "Agent DVR live camera",
    "de": "Agent DVR Live-Kamera"
  },
  "description": {
    "en": "Live tile of a camera, opens the live stream: from the adapter settings or set up here",
    "de": "Live-Kachel einer Kamera, öffnet den Livestream: aus den Adapter-Einstellungen oder hier eingestellt"
  },
  "icon": "../agent-dvr.png",
  "module": "agent-dvr-live.js",
  "size": {
    "width": 400,
    "height": 260
  },
  "settings": {
    "type": "panel",
    "items": {
      "mode": {
        "type": "select",
        "label": {
          "en": "Source",
          "de": "Quelle"
        },
        "default": "adapter",
        "options": [
          {
            "value": "adapter",
            "label": {
              "en": "Widget from the adapter settings",
              "de": "Widget aus den Adapter-Einstellungen"
            }
          },
          {
            "value": "custom",
            "label": {
              "en": "Own settings here",
              "de": "Eigene Einstellungen hier"
            }
          }
        ]
      },
      "widget": {
        "type": "objectId",
        "types": "state",
        "root": "agent-dvr",
        "label": {
          "en": "Widget",
          "de": "Widget"
        },
        "help": {
          "en": "The live widget of a camera, e.g. agent-dvr.0.cam_8_Garden.widget_live",
          "de": "Live-Widget einer Kamera, z. B. agent-dvr.0.cam_8_Garten.widget_live"
        },
        "hidden": "data.mode === 'custom'"
      },
      "camera": {
        "type": "objectId",
        "types": "device",
        "root": "agent-dvr",
        "label": {
          "en": "Camera",
          "de": "Kamera"
        },
        "help": {
          "en": "Choose the camera, e.g. agent-dvr.0.cam_8_Garden",
          "de": "Kamera wählen, z. B. agent-dvr.0.cam_8_Garten"
        },
        "hidden": "data.mode !== 'custom'"
      },
      "follow": {
        "type": "checkbox",
        "label": {
          "en": "Use the colors of the visualization",
          "de": "Farben der Visualisierung übernehmen"
        },
        "default": false,
        "help": {
          "en": "Tiles, badges, player and accent in the colors of the theme instead of the widget colors",
          "de": "Kacheln, Badges, Player und Akzent in den Farben des Themes statt der Widget-Farben"
        }
      },
      "hLive": {
        "type": "header",
        "text": {
          "en": "Live Widget",
          "de": "Live-Widget"
        },
        "size": 5,
        "hidden": "data.mode !== 'custom'"
      },
      "liveAspect": {
        "type": "text",
        "label": {
          "en": "Live tile aspect ratio (e.g. 16/9)",
          "de": "Seitenverhältnis Live-Kachel (z. B. 16/9)"
        },
        "default": "",
        "hidden": "data.mode !== 'custom'",
        "help": {
          "en": "Used when the adapter could not detect the resolution of the camera. Empty = automatic",
          "de": "Gilt, wenn der Adapter die Auflösung der Kamera nicht erkennen konnte. Leer = automatisch"
        }
      },
      "liveRefreshSec": {
        "type": "number",
        "label": {
          "en": "Snapshot refresh interval (s, 0 = never)",
          "de": "Aktualisierung Vorschaubild (s, 0 = nie)"
        },
        "min": 0,
        "max": 3600,
        "default": 0,
        "hidden": "data.mode !== 'custom'",
        "help": {
          "en": "Only the image is refreshed in the browser – an open player never closes",
          "de": "Nur das Bild wird im Browser erneuert – ein offener Player schließt sich nie"
        }
      },
      "compact": {
        "type": "checkbox",
        "label": {
          "en": "Compact layout",
          "de": "Kompaktes Layout"
        },
        "default": false,
        "hidden": "data.mode !== 'custom'",
        "help": {
          "en": "Smaller spacing and font – more entries at a glance",
          "de": "Kleinere Abstände und Schrift – mehr Einträge auf einen Blick"
        }
      },
      "maxModalWidth": {
        "type": "number",
        "label": {
          "en": "Max. player width (px)",
          "de": "Max. Player-Breite (px)"
        },
        "min": 300,
        "max": 2000,
        "default": 900,
        "hidden": "data.mode !== 'custom'"
      },
      "hColors": {
        "type": "header",
        "text": {
          "en": "Colors & Design",
          "de": "Farben & Design"
        },
        "size": 5,
        "hidden": "data.mode !== 'custom'"
      },
      "colorCardBg": {
        "type": "color",
        "label": {
          "en": "Tile background",
          "de": "Kachel-Hintergrund"
        },
        "default": "rgba(127,127,127,0.15)",
        "hidden": "data.mode !== 'custom' || data.follow"
      },
      "colorTagBg": {
        "type": "color",
        "label": {
          "en": "Tag badge background",
          "de": "Tag-Badge-Hintergrund"
        },
        "default": "rgba(0,0,0,0.55)",
        "hidden": "data.mode !== 'custom' || data.follow"
      },
      "colorTagText": {
        "type": "color",
        "label": {
          "en": "Tag badge text color",
          "de": "Tag-Badge-Textfarbe"
        },
        "default": "#ffffff",
        "hidden": "data.mode !== 'custom' || data.follow"
      },
      "colorModalBg": {
        "type": "color",
        "label": {
          "en": "Modal background",
          "de": "Modal-Hintergrund"
        },
        "default": "#1c1c1e",
        "hidden": "data.mode !== 'custom' || data.follow"
      },
      "borderRadius": {
        "type": "number",
        "label": {
          "en": "Border radius (px)",
          "de": "Eckenradius (px)"
        },
        "min": 0,
        "max": 32,
        "default": 8,
        "hidden": "data.mode !== 'custom'",
        "help": {
          "en": "Corner radius of the tiles (0 = square)",
          "de": "Abrundungsradius der Kacheln (0 = eckig)"
        }
      }
    }
  }
}
